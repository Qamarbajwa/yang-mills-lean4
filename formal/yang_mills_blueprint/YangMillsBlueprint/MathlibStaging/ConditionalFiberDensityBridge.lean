module

public import Mathlib.Analysis.SpecialFunctions.ExpDeriv
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Positivity
public import Mathlib.Tactic.Ring
public import YangMillsBlueprint.MathlibStaging.BlockPolymerOscillation
public import YangMillsBlueprint.MathlibStaging.CentralizerCodimensionBound
public import YangMillsBlueprint.MathlibStaging.GibbsDensityCapVariance
public import YangMillsBlueprint.MathlibStaging.PerturbedBlockSchur

/-!
# Stage 2A Conditional Fiber Density Cap and Polymer-Tail Contraction Bridge

Wires Stage-1 polymer effective oscillation (`BlockPolymerOscillation`) directly into Stage-2A
transverse bathtub variance floors (`GibbsDensityCapVariance` / `CentralizerCodimensionBound`) and
non-Markovian block Schur tail contraction (`PerturbedBlockSchur`):

* `ConditionalFiberDensityBridge.fiberDensityCap`: `Real.exp (effectiveBlockOsc B_int C θ)`.
* `ConditionalFiberDensityBridge.fiberVarianceFloor`: `4 / fiberDensityCap B_int C θ`.
* `ConditionalFiberDensityBridge.fiberVarianceFloor_anti_theta`: monotone floor stability in `θ`.
* `ConditionalFiberDensityBridge.fiber_tail_schur_contraction`: plugs `τ_e = polymerTailBound C θ`
  directly into `YM158` Schur contraction `perturbedRatioBound < ρ + τ_e`.
-/

@[expose] public section

namespace ConditionalFiberDensityBridge

open BlockPolymerOscillation GibbsDensityCapVariance PerturbedBlockSchur

/-- Worst-case Radon-Nikodym conditional fiber density cap generated by `effectiveBlockOsc`. -/
noncomputable def fiberDensityCap (B_int C θ : ℝ) : ℝ :=
  Real.exp (effectiveBlockOsc B_int C θ)

/-- Bathtub transverse variance floor `4 / M` induced by `fiberDensityCap`. -/
noncomputable def fiberVarianceFloor (B_int C θ : ℝ) : ℝ :=
  4 / fiberDensityCap B_int C θ

theorem fiberVarianceFloor_eq (B_int C θ : ℝ) :
    fiberVarianceFloor B_int C θ = 4 * Real.exp (-effectiveBlockOsc B_int C θ) := by
  unfold fiberVarianceFloor fiberDensityCap
  exact four_div_exp_eq_four_mul_exp_neg _

theorem fiberVarianceFloor_pos (B_int C θ : ℝ) :
    0 < fiberVarianceFloor B_int C θ := by
  rw [fiberVarianceFloor_eq]
  positivity

theorem one_le_fiberDensityCap {B_int C θ : ℝ} (hB : 0 ≤ B_int) (hC : 0 ≤ C)
    (hθ0 : 0 ≤ θ) (hθ1 : θ < 1) :
    1 ≤ fiberDensityCap B_int C θ := by
  unfold fiberDensityCap
  exact Real.one_le_exp (effectiveBlockOsc_nonneg hB hC hθ0 hθ1)

theorem fiberVarianceFloor_anti_theta {B_int C θ₁ θ₂ : ℝ} (hC : 0 ≤ C)
    (hθ10 : 0 ≤ θ₁) (hθ12 : θ₁ ≤ θ₂) (hθ21 : θ₂ < 1) :
    fiberVarianceFloor B_int C θ₂ ≤ fiberVarianceFloor B_int C θ₁ := by
  have h1 := sub_pos.mpr (lt_of_le_of_lt hθ12 hθ21)
  have h2 := sub_pos.mpr hθ21
  have htail : polymerTailBound C θ₁ ≤ polymerTailBound C θ₂ := by
    unfold polymerTailBound
    have hnum : C * θ₁ ≤ C * θ₂ := mul_le_mul_of_nonneg_left hθ12 hC
    have hden : 1 - θ₂ ≤ 1 - θ₁ := by linarith
    calc
      C * θ₁ / (1 - θ₁) ≤ C * θ₂ / (1 - θ₁) := div_le_div_of_nonneg_right hnum (le_of_lt h1)
      _ ≤ C * θ₂ / (1 - θ₂) :=
          div_le_div_of_nonneg_left (mul_nonneg hC (le_trans hθ10 hθ12)) h2 hden
  have hosc : effectiveBlockOsc B_int C θ₁ ≤ effectiveBlockOsc B_int C θ₂ := by
    unfold effectiveBlockOsc
    linarith
  rw [fiberVarianceFloor_eq, fiberVarianceFloor_eq]
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact Real.exp_le_exp.mpr (by linarith)

/-- Wires polymer tail `τ_e = polymerTailBound C θ` directly into `YM158`'s block Schur
contraction and recoil bounds. -/
theorem fiber_tail_schur_contraction {C θ ρ τ_o : ℝ} (hC : 0 ≤ C) (hθ0 : 0 ≤ θ) (hθ1 : θ < 1)
    (hρ0 : 0 < ρ) (hr : ρ + polymerTailBound C θ < 1)
    (hτole : τ_o ≤ polymerTailBound C θ)
    (hτoc : τ_o < ρ * (1 - polymerTailBound C θ - ρ) / (1 - polymerTailBound C θ)) :
    perturbedRatioBound ρ (polymerTailBound C θ) τ_o < ρ + polymerTailBound C θ ∧
      1 - (ρ + polymerTailBound C θ) < perturbedMarginNext ρ (polymerTailBound C θ) τ_o ∧
      recoilRatio ρ (polymerTailBound C θ) τ_o ≤ ρ + polymerTailBound C θ := by
  have hτe0 := polymerTailBound_nonneg hC hθ0 hθ1
  have hτe1 : polymerTailBound C θ < 1 := by linarith
  exact ⟨perturbedRatioBound_lt_tot hρ0 hr hτoc,
    perturbedMarginNext_gt_margin hρ0 hr hτoc,
    recoilRatio_le_self (le_of_lt hρ0) hτe0 hτe1 hτole (le_of_lt hr)⟩

end ConditionalFiberDensityBridge
